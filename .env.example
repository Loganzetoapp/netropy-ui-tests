# Copy to .env and fill in. Never commit .env.
NETROPY_URL=http://192.168.173.212
NETROPY_USER=
NETROPY_PASS=

# WAN emulator chained between NTG Port 3 and Port 4 (tests/t15_wan_emulator).
# Leave WAN_EMULATOR_URL unset to skip those tests.
WAN_EMULATOR_URL=http://192.168.173.213
WAN_EMULATOR_USER=
WAN_EMULATOR_PASS=
# true = WAN tests may borrow an Engine 2 that someone else left set up but
# idle (no traffic through it), and put it back exactly after the session.
# Unset/false = they skip instead. Traffic flowing always means skip.
WAN_BORROW_IDLE_ENGINE=false

# Optional — only needed to share webapp/ (the test dashboard) with other
# people on the network instead of just running it on your own machine.
# Leave all of these unset for the default: dashboard only reachable from
# this machine, no login. See webapp/README.md, "Sharing the dashboard".
# WEBAPP_HOST=0.0.0.0
# WEBAPP_PORT=8765
# WEBAPP_USER=
# WEBAPP_PASSWORD=

# Optional — enables automatic Claude review of dashboard-triggered test
# failures (evidence-grounded findings written straight to
# netropy-ui-findings.md, no Claude Code session needed). Leave unset to
# fall back to the free pending-review queue instead. Uses Haiku 4.5 —
# a few cents a day at typical failure volume. Get a key at
# https://console.anthropic.com/
# ANTHROPIC_API_KEY=
