# Copy to .env and fill in. Never commit .env.
NETROPY_URL=http://192.168.173.111:8080
NETROPY_USER=
NETROPY_PASS=

# Optional — only needed to share webapp/ (the test dashboard) with other
# people on the network instead of just running it on your own machine.
# Leave all of these unset for the default: dashboard only reachable from
# this machine, no login. See webapp/README.md, "Sharing the dashboard".
# WEBAPP_HOST=0.0.0.0
# WEBAPP_PORT=8765
# WEBAPP_USER=
# WEBAPP_PASSWORD=

# Optional — enables automatic Claude review of dashboard-triggered test
# failures (evidence-grounded findings appended to netropy-ui-findings.md).
# Leave unset to disable; costs a real API call per failed run. Get a key
# at https://console.anthropic.com/
# ANTHROPIC_API_KEY=
